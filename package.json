{
  "name": "rfmedia-apps",
  "version": "0.4.7",
  "private": true,
  "description": "A collection of self hosted web applications for family use.",
  "engines": {
    "node": ">=24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "rfmedia": "npm run dev -w packages/rfmedia-cli --",
    "rfapps": "npm run dev -w packages/rfapps-cli --",
    "format": "prettier --write",
    "format:all": "prettier --write .",
    "format:md": "prettier --write \"**/*.md\"",
    "format:docs": "prettier --write docs/**/*.md",
    "format:plans": "prettier --write docs/plans/**/*.md",
    "format:check": "prettier --check .",
    "format:rfmedia": "prettier --write \"packages/rfmedia-cli/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\"",
    "format:rfapps": "prettier --write \"packages/rfapps-cli/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\"",
    "format:common": "prettier --write \"packages/rf-common/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\"",
    "format:cli": "prettier --write \"packages/rf-common/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"packages/rfmedia-cli/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"packages/rfapps-cli/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\"",
    "lint": "npm run typecheck && npm run lint:md",
    "lint:fix": "npm run lint:md:fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "typecheck": "npm run typecheck -w packages/rf-common -w packages/rfmedia-cli -w packages/rfapps-cli",
    "build:common": "npm run build -w packages/rf-common",
    "build:rfmedia": "npm run build -w packages/rf-common -w packages/rfmedia-cli",
    "build:rfapps": "npm run build -w packages/rf-common -w packages/rfapps-cli",
    "build:cli": "npm run build -w packages/rf-common -w packages/rfmedia-cli -w packages/rfapps-cli",
    "build:all": "npm run build -w packages/rf-common -w packages/rfmedia-cli -w packages/rfapps-cli",
    "link:rfmedia": "npm run build -w packages/rfmedia-cli && npm link -w packages/rfmedia-cli",
    "link:rfapps": "npm run build -w packages/rf-common -w packages/rfapps-cli && npm link -w packages/rfapps-cli",
    "link": "npm run build -w packages/rf-common -w packages/rfmedia-cli -w packages/rfapps-cli && npm link -w packages/rfmedia-cli -w packages/rfapps-cli",
    "link:all": "npm run link",
    "unlink:rfmedia": "npm unlink -g rfmedia",
    "unlink:rfapps": "npm unlink -g rfapps",
    "unlink": "npm unlink -g rfmedia rfapps",
    "unlink:all": "npm run unlink",
    "test:common": "npm run test:run -w packages/rf-common",
    "test:rfmedia": "npm run test:run -w packages/rfmedia-cli",
    "test:rfapps": "npm run test:run -w packages/rfapps-cli",
    "test:contracts": "npm run test:architecture -w packages/rfmedia-cli && npm run test:codegen:lidarr -w packages/rfmedia-cli",
    "test": "npm run test:run",
    "test:run": "bash scripts/test-run.sh",
    "test:all": "npm run test",
    "test:coverage:rfmedia": "npm run test:coverage -w packages/rfmedia-cli",
    "test:coverage:rfapps": "npm run test:coverage -w packages/rfapps-cli",
    "test:coverage:common": "npm run test:coverage -w packages/rf-common",
    "test:coverage": "npm run test:coverage:common && npm run test:coverage:rfmedia && npm run test:coverage:rfapps",
    "test:coverage:all": "npm run test:coverage",
    "bench:rfmedia": "npm run bench -w packages/rfmedia-cli",
    "tf:plan": "bash scripts/tf.sh plan",
    "tf:apply": "bash scripts/tf.sh apply",
    "tf:plan:apply": "bash scripts/tf.sh plan-apply",
    "tf:plan:cloudflare": "bash scripts/tf.sh plan cloudflare",
    "tf:apply:cloudflare": "bash scripts/tf.sh apply cloudflare",
    "tf:plan:apply:cloudflare": "bash scripts/tf.sh plan-apply cloudflare"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.8.1"
  }
}
