# ============================================================
# rfmedia-apps - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# See docs/reference/environment-variables.md for full details.
# ============================================================

# --- Core ---
TZ=America/New_York
PUID=1000
PGID=1000
PROJECT_DIR=/path/to/rfmedia-apps

# --- Directory Paths ---
DOCKER_DIR=/path/to/docker/configs
DOCKER_DATA_DIR=/path/to/docker/data
DATA_DIR=/path/to/media
PLEX_DOCKER_DIR=/path/to/plex/config

# --- Docker Logging ---
DOCKERLOGGING_MAXFILE=3
DOCKERLOGGING_MAXSIZE=10m

# --- Domains & SSL ---
DOMAIN=example.com
DOMAIN2=media.example.com
TS_DOMAIN=tailnet-name.ts.net
CF_API_EMAIL=admin@example.com
CF_DNS_API_TOKEN=changeme
# Optional: WAF custom rules (Zone.Firewall Services Edit on the media zone)
# CF_WAF_API_TOKEN=changeme

# --- Network ---
NAS01_IP=192.168.1.100
NAS02_IP=192.168.1.101
HOMEAUTO_SERVER=192.168.1.200
VPN_LAN_NETWORK=192.168.1.0/24

# --- Tailscale ---
TS_AUTHKEY=tskey-auth-xxxxx
TAILSCALE_OAUTH_CLIENT_ID=oauth-client-id
TAILSCALE_OAUTH_CLIENT_SECRET=oauth-client-secret
DOCKTAIL_DEFAULT_SERVICE_TAGS=tag:container
DOCKTAIL_LOG_LEVEL=info
DOCKTAIL_RECONCILE_INTERVAL=60s
# Populates ${DOCKER_DIR}/tsdproxy-rfapps/config/tsdproxy.yaml (Forgejo tailnet host)
TSDPROXY_AUTHKEY=tskey-auth-xxxxx
# Populates ${DOCKER_DIR}/tsdproxy-rfapps/config/tsdproxy.yaml (Forgejo tailnet host)
TSDPROXY_AUTHKEY=tskey-auth-xxxxx

# --- Cloudflare Tunnel (Terraform-managed) ---
# Cloudflare account ID (Dashboard -> Account Home -> right sidebar)
CF_ACCOUNT_ID=00000000000000000000000000000000
# Custom API token: Account.Cloudflare Tunnel Edit, Zone.DNS Edit, Zone.Zone Read
# (zone resources: the zones for DOMAIN and DOMAIN2)
CF_TERRAFORM_API_TOKEN=changeme
# Generated by `npm run tf:apply:cloudflare` — do not hand-enter
CF_TUNNEL_TOKEN=changeme

# --- Authentik (Identity Provider) ---
AUTHENTIK_SECRET_KEY=changeme
AUTHENTIK_POSTGRES_PASSWORD=changeme
AUTHENTIK_TOKEN=changeme
AUTHENTIK_HOST_BROWSER=https://authentik.example.com

# Authentik Email (SMTP)
AUTHENTIK_EMAIL_HOST=smtp.example.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USERNAME=user@example.com
AUTHENTIK_EMAIL_PASSWORD=changeme
AUTHENTIK_EMAIL_FROM=authentik@example.com

# --- Plex ---
PLEX_CLAIM=claim-xxxxx
PLEX_ADVERTISE_URL=https://plex.media.example.com:443
# Second Plex instance (music). Use a separate claim token from plex.tv/claim.
PLEX_CLAIM_MUSIC=claim-xxxxx
PLEX_ADVERTISE_URL_MUSIC=https://plex-music.media.example.com:443

# --- llama.cpp (AMD ROCm inference; native API-key auth) ---
# Filename under ${DOCKER_DIR}/llama/models; see docs/services/llama-setup.md.
# Example default only; op run injects the vault LLAMA_MODEL_FILE override.
LLAMA_MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
# Match host render group: stat -c %g /dev/dri/by-path/pci-0000:07:00.0-render
LLAMA_RENDER_GID=993
# op://EnvSecrets/RFMEDIA_SECRETS/.env.local/LLAMA_API_KEY — never track plaintext
# keys here. Reference this field in ignored .env.local; provision the 0400 file
# using docs/services/llama-setup.md before deployment.
# LLAMA_API_KEY=op://EnvSecrets/RFMEDIA_SECRETS/.env.local/LLAMA_API_KEY

# --- Downloads ---
NZBGET_USER=changeme
NZBGET_PASS=changeme

# --- Soulseek / SLSKD ---
SLSKD_PASSWORD=changeme
SLSKD_SLSK_USERNAME=changeme
SLSKD_SLSK_PASSWORD=changeme
SLSKD_API_KEY=changeme
SLSKD_JWT_KEY=changeme

# --- Immich (Photos) ---
IMMICH_DB_NAME=immich
IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=changeme

# --- Forgejo (Git) ---
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=changeme

# Forgejo Actions runner (reference URLs for docs/setup; token file on host — see docs/services/forgejo-setup.md)
FORGEJO_RUNNER_INSTANCE_URL=https://git.${DOMAIN}
# Internal URL used in runner-config.yml server.connections (Docker apps network)
FORGEJO_RUNNER_INTERNAL_URL=http://forgejo:3000

# --- Service Keys ---
HOMARR_SECRET_KEY=changeme
SPEEDTEST_APP_KEY=changeme
TP_THEME=dracula

# --- tokenhop ---
# Pin TOKENHOP_TAG to a reviewed release from https://github.com/tokenhop/tokenhop/releases.
TOKENHOP_IMAGE=ghcr.io/tokenhop/tokenhop
TOKENHOP_TAG=latest
TOKENHOP_INITIAL_PASSWORD=changeme
TOKENHOP_JWT_SECRET=changeme
TOKENHOP_API_KEY_SECRET=changeme
TOKENHOP_MACHINE_ID_SALT=changeme
TOKENHOP_AUTH_COOKIE_SECURE=true
TOKENHOP_ENABLE_REQUEST_LOGS=false
TOKENHOP_HEADROOM_URL=http://headroom:8787

# --- Headroom ---
# Pin TOKENHOP_TAG to a reviewed release from https://github.com/tokenhop/tokenhop/releases.
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom
HEADROOM_TAG=0.37.0
HEADROOM_DIGEST=sha256:4e559273659ebc5ce8711a60278e288550fa596377af18a7058e10036d63ef0b
HEADROOM_MODE=cache
HEADROOM_SAVINGS_PROFILE=coding
# Disable Headroom's anonymous beacon and local telemetry by default.
HEADROOM_BEACON=off
HEADROOM_TELEMETRY=off

# --- Praxrr Keys ---
PRAXRR_DEFAULT_DB_TOKEN=${PRAXRR_DEFAULT_DB_TOKEN}
PRAXRR_DEFAULT_DB_GIT_USERNAME=${PRAXRR_DEFAULT_DB_GIT_USERNAME}
PRAXRR_DEFAULT_DB_GIT_EMAIL=${PRAXRR_DEFAULT_DB_GIT_EMAIL}

# ============================================================
# Optional: CLI Overrides (uncomment as needed)
# ============================================================
# PLEX_URL=http://plex:32400
# PLEX_TOKEN=your-plex-token
# RFAPPS_COMPOSE_PATH=./compose.yml
# RFAPPS_ENV_FILE=.env
# RFAPPS_DEBUG=false
# RF_DEBUG=false
