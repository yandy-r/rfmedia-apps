{
  "name": "rfapps",
  "version": "0.4.1",
  "description": "Docker orchestration CLI for rfmedia-apps - TypeScript replacement for manage.sh",
  "type": "module",
  "bin": {
    "rfapps": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run set-permissions",
    "copy-assets": "cp src/lib/schema.sql dist/lib/schema.sql",
    "set-permissions": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/cli.ts mcp",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "keywords": [
    "cli",
    "docker",
    "compose",
    "orchestration",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@rfmedia/common": "*",
    "better-sqlite3": "^12.6.2",
    "cli-truncate": "^5.1.1",
    "commander": "^14.0.0",
    "fastest-levenshtein": "^1.0.16",
    "ink": "^5.2.0",
    "ipaddr.js": "^2.4.0",
    "listr2": "^9.0.0",
    "picocolors": "^1.0.0",
    "react": "^18.3.1",
    "string-width": "^8.1.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
