{
  "name": "rfmedia",
  "version": "0.5.0",
  "description": "Media file management CLI for copying albums with numbered suffixes and cleaning empty directories",
  "type": "module",
  "bin": {
    "rfmedia": "./dist/bootstrap.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run set-permissions",
    "prebuild": "npm run codegen:lidarr:check && npm run check:architecture",
    "copy-assets": "cp src/lib/schema.sql dist/lib/schema.sql",
    "set-permissions": "chmod +x dist/bootstrap.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:memory": "tsx benchmarks/memory-probe.ts",
    "codegen:lidarr": "node scripts/generate-lidarr-client.mjs write",
    "codegen:lidarr:check": "node scripts/generate-lidarr-client.mjs check",
    "test:codegen:lidarr": "node --test scripts/generate-lidarr-client.test.mjs scripts/refresh-lidarr-openapi.test.mjs",
    "openapi:lidarr:refresh": "node scripts/refresh-lidarr-openapi.mjs",
    "check:architecture": "node scripts/check-direct-plex-imports.mjs",
    "test:architecture": "node --test scripts/check-direct-plex-imports.test.mjs",
    "pretypecheck": "npm run codegen:lidarr:check && npm run check:architecture && npm run test:architecture",
    "typecheck": "tsc --noEmit && tsc --noEmit -p benchmarks/tsconfig.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "cli",
    "media",
    "music",
    "audio",
    "hardlink",
    "copy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@rfmedia/common": "*",
    "better-sqlite3": "^12.6.2",
    "js-yaml": "^4.3.0",
    "check-disk-space": "^3.4.0",
    "cli-truncate": "^5.1.1",
    "chokidar": "^4.0.0",
    "cli-progress": "^3.12.0",
    "console-table-printer": "^2.14.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.0.0",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.0.0",
    "ink": "^5.2.0",
    "listr2": "^9.0.0",
    "music-metadata": "^11.14.0",
    "p-limit": "^6.0.0",
    "picocolors": "^1.0.0",
    "picomatch": "^4.0.3",
    "react": "^18.3.1",
    "string-width": "^8.1.1",
    "trash": "^10.0.1",
    "node-id3": "^0.2.6",
    "flac-metadata": "^0.1.0",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.93.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^18.3.0",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.0.17",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
