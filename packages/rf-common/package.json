{
  "name": "@rfmedia/common",
  "version": "0.4.1",
  "description": "Shared utilities for rfmedia CLI tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js"
    },
    "./env-tools": {
      "types": "./dist/env-tools.d.ts",
      "import": "./dist/env-tools.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "keywords": [
    "cli",
    "utilities",
    "logging",
    "progress"
  ],
  "license": "MIT",
  "dependencies": {
    "listr2": "^9.0.0",
    "picocolors": "^1.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
